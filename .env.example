# Adresse du portail ouverte par « Accéder au Portail ». Sans elle, le bouton mène à la page /portail (« bientôt disponible »).
NEXT_PUBLIC_PORTAL_URL=

# Formulaire de contact : clé d'API Resend (https://resend.com). Sans elle, aucun message ne part.
RESEND_API_KEY=
# Expéditeur : une adresse d'un domaine vérifié dans Resend. Par défaut « Site Target Quality Solutions <site@targetquality.net> ».
CONTACT_FROM=
# Destinataire. Par défaut contact@targetquality.net.
CONTACT_TO=
